# --- Server ---
PORT=3000
SITE_URL=http://localhost:3000
SESSION_SECRET=change_this_to_a_long_random_string

# --- MongoDB ---
# Free cluster: https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pdfstore

# --- Admin login (simple fixed credentials) ---
ADMIN_USER=admin
ADMIN_PASS=change_this_password

# --- SSLCommerz (sandbox) ---
# Get free sandbox credentials: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sandbox_store_password
SSLCOMMERZ_IS_LIVE=false

# --- Manual payment info shown to buyers ---
MANUAL_BKASH_NUMBER=01XXXXXXXXX
MANUAL_NAGAD_NUMBER=01XXXXXXXXX
